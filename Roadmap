7. 🎮 Smooth Animations & Easing
Current Gap: Animations use NumberAnimation with linear easing (feels robotic).

Improvements:

QML
// Update Theme.qml with easing presets
Theme {
    // Easing functions for consistency
    enum Easing {
        EaseOutCubic
        EaseInOutCubic
        EaseOutExpo
        EaseOutBack
        Elastic
    }

    // Animation durations
    readonly int animFast: 150      // Micro-interactions
    readonly int animNormal: 280    // Panel slides
    readonly int animSlow: 500      // Ambient fade

    readonly int animBounce: 350    // Spring effects
}

// Apply smooth easing to all panel transitions
LeftSidebar {
    open: false

    PropertyAnimation on x {
        duration: Theme.animNormal
        easing.type: Easing.OutCubic  // Natural deceleration
    }

    PropertyAnimation on opacity {
        duration: Theme.animNormal
        easing.type: Easing.InOutCubic
    }

    // On hover enter: spring bounce
    SequentialAnimationGroup on scale {
        PropertyAnimation {
            to: 1.02
            duration: 150
            easing.type: Easing.OutBack
        }
        PropertyAnimation {
            to: 1.0
            duration: 100
            easing.type: Easing.OutBack
        }
    }
}

// Workspace transition indicator with smooth easing
DesktopTransition {
    duration: Theme.animSlow
    easing: Easing.OutCubic

    // Visual indicator: arrow pointing in switch direction
    ArrowIndicator {
        from: previousWorkspaceId
        to: nextWorkspaceId
        direction: {
            const diff = nextWorkspaceId - previousWorkspaceId;
            return diff > 0 ? "→" : "←";
        }
    }
}
