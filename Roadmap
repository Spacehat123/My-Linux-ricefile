                }

                Text {
                    text: `${modelData.workspaceCount} workspaces`
                    font.pixelSize: 12
                    color: Theme.foreground
                }

                WorkspaceGrid {
                    Repeater {
                        model: modelData.workspaces

                        WorkspacePill {
                            text: modelData.id
                            isActive: modelData.active
                        }
                    }
                }
            }
        }
    }
}

// Settings for multi-monitor workflow
MultiMonitorSettings {
    id: mmSettings

    ToggleSwitch {
        label: "Independent Workspaces per Monitor"
        value: multimon.independentWorkspaces
        onToggled: multimon.independentWorkspaces = value
    }

    ToggleSwitch {
        label: "Mirror Workspaces Across Monitors"
        value: !multimon.independentWorkspaces
        onToggled: multimon.independentWorkspaces = !value
    }

    RadioGroup {
        label: "Mouse Movement"
        options: ["Stay on Monitor", "Wrap Around", "Jump to Nearest"]
        value: multimon.mouseMovement
        onChanged: multimon.mouseMovement = value
    }
}
